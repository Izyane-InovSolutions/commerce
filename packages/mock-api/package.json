{
  "name": "@commerce/mock-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "In-memory Commerce API stand-in, served while the real API is built",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "serve": "node src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@commerce/contracts": "0.1.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
