{
  "name": "@commerce/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared request and response contract for the Commerce API",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.1"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
