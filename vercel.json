{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "apps/web" },
    "admin": { "root": "apps/admin" },
    "seller": { "root": "apps/seller" }
  },
  "rewrites": [
    { "source": "/admin", "destination": { "service": "admin" } },
    { "source": "/admin/(.*)", "destination": { "service": "admin" } },
    { "source": "/seller", "destination": { "service": "seller" } },
    { "source": "/seller/(.*)", "destination": { "service": "seller" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
