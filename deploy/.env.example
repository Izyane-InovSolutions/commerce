# Copy to deploy/.env and fill in. deploy/.env is gitignored (**/.env) and must
# never be committed — it holds the signing secrets for every session token.
#
# Generate each secret separately:
#   openssl rand -base64 48

# ---------------------------------------------------------------- Postgres
# Consumed by the postgres container AND spliced into DATABASE_URL below.
POSTGRES_USER=commerce
POSTGRES_PASSWORD=
POSTGRES_DB=commerce

# ------------------------------------------------------------------ tunnel
# NOT NEEDED for internal LAN testing — leave this empty. It is only read when
# the stack is started with `--profile tunnel`, which is how you would expose
# the API to the public internet later. See "Publishing it later" in README.md.
TUNNEL_TOKEN=

# ----------------------------------------------------------------- runtime
NODE_ENV=production
PORT=3000

# `postgres` is the compose service name, resolved on the internal network.
# Keep the credentials here in step with POSTGRES_* above.
DATABASE_URL=postgresql://commerce:CHANGE_ME@postgres:5432/commerce?schema=public

# Only `prisma migrate dev` ever connects to a shadow database, and that is a
# development command — `migrate deploy`, which is what runs here, never does.
# It is set anyway because src/infrastructure/config/env.validation.ts marks it
# required, and the app refuses to boot without it. The value is validated as a
# URL, not connected to, so this database does not need to exist.
SHADOW_DATABASE_URL=postgresql://commerce:CHANGE_ME@postgres:5432/commerce_shadow?schema=public

# ------------------------------------------------------------------- auth
# Minimum 32 characters, enforced at boot. Rotating this invalidates every
# access and refresh token in circulation, signing all users out.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ------------------------------------------------------------------ media
# Absolute, and matches the volume mount in docker-compose.yml. The repo
# default (.data/media) is relative to the working directory and would put
# uploads inside the container's writable layer, where they are lost on the
# next deploy.
MEDIA_STORAGE_PATH=/var/lib/commerce/media
# Separate from JWT_SECRET — this one signs media URLs. Minimum 32 characters.
MEDIA_SIGNING_SECRET=
MEDIA_MAX_FILE_SIZE_BYTES=10485760
MEDIA_URL_TTL_SECONDS=900
MEDIA_PUBLIC_URL_TTL_SECONDS=86400

# --------------------------------------------------------------- workers
# The cron and interval workers in src/infrastructure/jobs. Leave unset (or
# `true`) while a single API container runs. Set to `false` on every extra
# replica you add, or each one will run the same scheduled job concurrently.
SCHEDULED_WORKERS_ENABLED=true

# -------------------------------------------------------------- payments
# `pending` refuses every charge, which is the safe default. Switching to
# `unified` requires UNIFIED_PAYMENTS_BASE_URL over HTTPS: the provider
# refuses to send credentials over plain HTTP outside development.
PAYMENTS_PROVIDER=pending
UNIFIED_PAYMENTS_MERCHANT_ID=Kausa
UNIFIED_PAYMENTS_TIMEOUT_MS=15000
UNIFIED_PAYMENTS_CARD_CURRENCY=USD
PAYMENT_FX_QUOTES={}

# The three settings below are deliberately LEFT OUT rather than set empty.
# Compose passes `FOO=` through as an empty string, and class-validator's
# @IsOptional() only skips null/undefined — an empty string is still a value,
# so it gets run through @IsUrl and the API refuses to boot with
#   "property UNIFIED_PAYMENTS_CALLBACK_URL has failed ... isUrl".
# Uncomment and fill them in only when switching PAYMENTS_PROVIDER to
# `unified`; the first two are required in that case.
# UNIFIED_PAYMENTS_BASE_URL=https://gateway.example.com
# UNIFIED_PAYMENTS_API_KEY=nsk_test_...
# UNIFIED_PAYMENTS_CALLBACK_URL=https://api.example.com/api/v1/payments/callback

# ------------------------------------------------------ marketplace rules
MARKETPLACE_COMMISSION_BPS=1000
SHIPPING_DOMESTIC_COUNTRY=ZM
SHIPPING_DOMESTIC_RATE_MINOR=3000
SHIPPING_DOMESTIC_FREE_THRESHOLD_MINOR=50000
SHIPPING_INTERNATIONAL_RATE_MINOR=15000
SHIPPING_UNSUPPORTED_COUNTRIES=
SHIPPING_QUOTE_TTL_SECONDS=3600

# ------------------------------------------------------------------- seed
# Used only by `prisma db seed`, which refuses to run unless NODE_ENV is
# development or test — see "Seeding test data" in README.md. These are test
# credentials for the internal environment; do not keep them once this server
# is reachable from outside.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=DemoAdmin123!
