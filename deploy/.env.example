POSTGRES_USER=commerce
POSTGRES_PASSWORD=
POSTGRES_DB=commerce

TUNNEL_TOKEN=

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://commerce:CHANGE_ME@postgres:5432/commerce?schema=public
SHADOW_DATABASE_URL=postgresql://commerce:CHANGE_ME@postgres:5432/commerce_shadow?schema=public

JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

MEDIA_STORAGE_PATH=/var/lib/commerce/media
MEDIA_SIGNING_SECRET=
MEDIA_MAX_FILE_SIZE_BYTES=10485760
MEDIA_URL_TTL_SECONDS=900
MEDIA_PUBLIC_URL_TTL_SECONDS=86400

SCHEDULED_WORKERS_ENABLED=true

PAYMENTS_PROVIDER=pending
UNIFIED_PAYMENTS_MERCHANT_ID=Kausa
UNIFIED_PAYMENTS_TIMEOUT_MS=15000
UNIFIED_PAYMENTS_CARD_CURRENCY=USD
UNIFIED_PAYMENTS_BASE_URL=http://72.62.61.21:9002
UNIFIED_PAYMENTS_ALLOW_HTTP=true
PAYMENT_FX_QUOTES={}

MARKETPLACE_COMMISSION_BPS=1000
SHIPPING_DOMESTIC_COUNTRY=ZM
SHIPPING_DOMESTIC_RATE_MINOR=3000
SHIPPING_DOMESTIC_FREE_THRESHOLD_MINOR=50000
SHIPPING_INTERNATIONAL_RATE_MINOR=15000
SHIPPING_UNSUPPORTED_COUNTRIES=
SHIPPING_QUOTE_TTL_SECONDS=3600

# Bases the API builds email links from (password reset, order updates,
# seller notifications). Set both in production — the defaults point at
# localhost. The web apps are deployed separately (Vercel, see vercel.json)
# on one origin: the storefront at `/` and the seller portal under `/seller`,
# so SELLER_APP_URL carries that base path. The storefront's
# NEXT_PUBLIC_SELLER_APP_URL, set in its Vercel project, takes the same value.
# WEB_APP_URL=https://shop.example.com
# SELLER_APP_URL=https://shop.example.com/seller

SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=DemoAdmin123!
