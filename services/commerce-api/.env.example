NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce?schema=public
SHADOW_DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce_shadow?schema=public
JWT_SECRET=change-me-to-a-long-random-value-in-every-environment
# Each JSON value must be a separately generated 32-byte base64 key. Keep old
# entries while ciphertext bearing that key id can still exist.
REFRESH_RECOVERY_ENCRYPTION_ACTIVE_KEY_ID=v1
REFRESH_RECOVERY_ENCRYPTION_KEYS={"v1":"change-me-to-a-base64-32-byte-key"}
EMAIL_DELIVERY_ENCRYPTION_ACTIVE_KEY_ID=v1
EMAIL_DELIVERY_ENCRYPTION_KEYS={"v1":"change-me-to-a-different-base64-32-byte-key"}
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Commerce <no-reply@commerce.local>"
CUSTOMER_WEB_URL=http://localhost:3001
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SEND_TIMEOUT_MS=30000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
MEDIA_STORAGE_PATH=.data/media
MEDIA_SIGNING_SECRET=change-me-to-a-separate-long-random-value
MEDIA_MAX_FILE_SIZE_BYTES=10485760
MEDIA_URL_TTL_SECONDS=900
# How long a product image URL stays valid. Longer than the general TTL above
# because these are embedded in catalog responses that clients cache — a short
# one would expire while a cached page was still showing it.
MEDIA_PUBLIC_URL_TTL_SECONDS=86400
# Where uploaded media is stored: `local` (MEDIA_STORAGE_PATH on disk) or `s3`
# for any S3-compatible bucket. The S3_* values are required only for `s3`.
# Objects stay private either way — downloads are still served through the
# API's signed /media/:id/download URLs, not bucket URLs.
MEDIA_STORAGE_DRIVER=local
S3_BUCKET=
# Use `auto` for Cloudflare R2.
S3_REGION=
# Leave empty for AWS S3. Set for R2 (https://<account>.r2.cloudflarestorage.com)
# or MinIO (http://localhost:9000).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# `true` for MinIO and most self-hosted stores, which only serve path-style
# (endpoint/bucket/key) requests.
S3_FORCE_PATH_STYLE=false

# Set to `unified` to send payments to the Unified Payments gateway; anything
# else keeps the pending stand-in, which refuses every charge.
PAYMENTS_PROVIDER=pending
# The documented sandbox origin is http://72.62.61.21:9002 — an origin only,
# with no path. Plain HTTP is accepted when NODE_ENV is development or test;
# outside those the provider requires HTTPS and refuses to send credentials.
UNIFIED_PAYMENTS_BASE_URL=
# Sent as X-API-Key. Sandbox keys are prefixed nsk_test_.
UNIFIED_PAYMENTS_API_KEY=
UNIFIED_PAYMENTS_MERCHANT_ID=Kausa
UNIFIED_PAYMENTS_TIMEOUT_MS=15000
# Orders and customer-facing amounts stay in ZMW. The existing card connector
# supports USD or GBP settlement; conversion occurs only on the backend.
UNIFIED_PAYMENTS_CARD_CURRENCY=USD
# Live FX rates (exchangerate-api.com), refreshed hourly by
# FxRatesRefreshScheduler. Leave unset (not empty) to use PAYMENT_FX_QUOTES.
# PAYMENT_FX_API_KEY=
PAYMENT_FX_BASE_CURRENCY=ZMW
# Manual fallback quote source, used only when PAYMENT_FX_API_KEY is empty.
# JSON keyed by target currency, each value has rate (decimal STRING, target
# units per ZMW), quoteId, and expiresAt (ISO date). No default or estimated
# rates are supplied. Missing, expired, zero or invalid quotes disable foreign
# settlement safely.
PAYMENT_FX_QUOTES={}
# Where the gateway should report status changes. Leave unset: this API can
# receive a callback but cannot yet verify one — the gateway's signing scheme
# is not in its documentation — so every delivery would be rejected. (An empty
# value fails the URL validation at startup.)
# UNIFIED_PAYMENTS_CALLBACK_URL=

# Basis points (1/100 of a percent) - 1000 = 10%.
MARKETPLACE_COMMISSION_BPS=1000

# Zone-based shipping policy until a carrier contract is selected (see
# ZoneShippingRateProvider). Amounts are minor units in the checkout
# currency (ZMW). Domestic is ZMW's home market and gets the cheaper rate
# plus a free-shipping threshold; every other destination pays the flat
# international rate.
SHIPPING_DOMESTIC_COUNTRY=ZM
SHIPPING_DOMESTIC_RATE_MINOR=3000
SHIPPING_DOMESTIC_FREE_THRESHOLD_MINOR=50000
SHIPPING_INTERNATIONAL_RATE_MINOR=15000
# Comma-separated ISO-2 country codes shipping is refused to. Empty by
# default — there is no real carrier restriction list yet.
SHIPPING_UNSUPPORTED_COUNTRIES=
SHIPPING_QUOTE_TTL_SECONDS=3600

# Bases for links in emails: the storefront (password reset, order updates)
# and the seller app (seller notifications). Include the seller app's basePath
# (/seller) — links are appended to it, not resolved against the origin.
WEB_APP_URL=http://localhost:3001
SELLER_APP_URL=http://localhost:3003/seller

# Outgoing email. Set SMTP_URL (e.g. smtps://user:pass@smtp.example.com) or
# the SMTP_HOST group; SMTP_URL wins if both are set. Left empty, mail is
# written to the API log in development/test and not sent in production.
SMTP_URL=
SMTP_HOST=
# Defaults to 465 when SMTP_SECURE=true, else 587.
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Commerce <no-reply@localhost>

# Operations. Empty METRICS_SCRAPE_TOKEN disables GET /api/v1/metrics/prometheus;
# set a random value of at least 32 characters for the internal scraper.
METRICS_SCRAPE_TOKEN=
METRICS_DB_CACHE_MS=15000
# Readiness reports 503 this long after SIGTERM before connections stop.
SHUTDOWN_DRAIN_DELAY_MS=0
# Per-process application requests allowed in flight before responding 503.
MAX_IN_FLIGHT_REQUESTS=16

# Optional local dummy admin: npm run prisma:seed (development/test only).
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=DemoAdmin123!
