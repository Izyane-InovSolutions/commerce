NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce?schema=public
SHADOW_DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce_shadow?schema=public
JWT_SECRET=change-me-to-a-long-random-value-in-every-environment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
MEDIA_STORAGE_PATH=.data/media
MEDIA_SIGNING_SECRET=change-me-to-a-separate-long-random-value
MEDIA_MAX_FILE_SIZE_BYTES=10485760
MEDIA_URL_TTL_SECONDS=900
