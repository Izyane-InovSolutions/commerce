NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce?schema=public
SHADOW_DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce_shadow?schema=public
JWT_SECRET=change-me-to-a-long-random-value-in-every-environment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
MEDIA_STORAGE_PATH=.data/media
MEDIA_SIGNING_SECRET=change-me-to-a-separate-long-random-value
MEDIA_MAX_FILE_SIZE_BYTES=10485760
MEDIA_URL_TTL_SECONDS=900
# How long a product image URL stays valid. Longer than the general TTL above
# because these are embedded in catalog responses that clients cache — a short
# one would expire while a cached page was still showing it.
MEDIA_PUBLIC_URL_TTL_SECONDS=86400

# Set to `unified` to send payments to the Unified Payments gateway; anything
# else keeps the pending stand-in, which refuses every charge.
PAYMENTS_PROVIDER=pending
# The documented sandbox origin is http://72.62.61.21:9002 — an origin only,
# with no path. Plain HTTP is accepted when NODE_ENV is development or test;
# outside those the provider requires HTTPS and refuses to send credentials.
UNIFIED_PAYMENTS_BASE_URL=
# Sent as X-API-Key. Sandbox keys are prefixed nsk_test_.
UNIFIED_PAYMENTS_API_KEY=
UNIFIED_PAYMENTS_MERCHANT_ID=Kausa
UNIFIED_PAYMENTS_TIMEOUT_MS=15000
# Orders and customer-facing amounts stay in ZMW. The existing card connector
# supports USD or GBP settlement; conversion occurs only on the backend.
UNIFIED_PAYMENTS_CARD_CURRENCY=USD
# Backend quote source until a live FX adapter is integrated. JSON keyed by
# target currency, each value has rate (decimal STRING, target units per ZMW),
# quoteId, and expiresAt (ISO date). No default or estimated rates are supplied.
# Missing, expired, zero or invalid quotes disable foreign settlement safely.
PAYMENT_FX_QUOTES={}
# Where the gateway should report status changes. Leave empty: this API can
# receive a callback but cannot yet verify one — the gateway's signing scheme
# is not in its documentation — so every delivery would be rejected.
UNIFIED_PAYMENTS_CALLBACK_URL=

# Basis points (1/100 of a percent) - 1000 = 10%.
MARKETPLACE_COMMISSION_BPS=1000

# Optional local dummy admin: npm run prisma:seed (development/test only).
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=DemoAdmin123!
