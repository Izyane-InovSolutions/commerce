# Base URL of the Commerce API, including the version prefix.
#
# The NestJS API reads PORT from services/commerce-api/.env — the team's local
# setup runs it on 3005. The stand-in mock (`npm run mock:dev`) serves 3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3005/api/v1

# Where the seller portal (apps/seller) is served — the account page's
# "Seller dashboard"/"Become a seller" buttons link here.
NEXT_PUBLIC_SELLER_APP_URL=http://localhost:3003
