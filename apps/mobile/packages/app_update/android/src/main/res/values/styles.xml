<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Translucent, so handing over to the system installer does not flash
         an empty screen; DayNight, so any dialog it shows matches the phone. -->
    <style name="AppUpdate.Install" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
