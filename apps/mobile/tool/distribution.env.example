# Copy to tool/distribution.env. None of this is secret, but it is
# per-project; the Firebase console shows the app ids under
# Project settings → Your apps.
FIREBASE_ANDROID_APP_ID=1:538169518184:android:050108abfa85d32c4073dd
# Register the iOS app (com.izyane.commerceMobile) in the good-for-goods
# project, then put its app id here.
FIREBASE_IOS_APP_ID=

# Tester groups (App Distribution → Testers & Groups), comma-separated.
FIREBASE_GROUPS=internal-testers

# The API builds point at. Can be overridden per run on the command line.
API_BASE_URL=${API_BASE_URL:-}
